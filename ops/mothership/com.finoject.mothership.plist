<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  テンプレート。__HOME__ を実際のホーム（/Users/ユーザー名）に置換して
  ~/Library/LaunchAgents/ に置く。launchd は plist 内の `~` を展開しないため絶対パスが必須。
  install.sh を使えば置換・配置・登録をまとめて行う。

  LaunchAgent（LaunchDaemonではない）なのは、claude の認証情報がユーザーの
  Keychain と ~/.claude にあるため。root で動かすと認証が読めない。
  その代わり「GUIログイン中しか動かない」ので、自動ログインの有効化が前提になる。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.finoject.mothership</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/mothership/mothership.sh</string>
    </array>

    <!-- ログイン直後に起動し、落ちたら必ず上げ直す。これが常駐化の本体。 -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- 認証切れ等で即死する場合に再起動を連打しないための下限間隔（秒） -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- App Nap / タイマー抑制の対象外にする。Background にすると
         長時間アイドル時にスロットリングされ、接続が切れやすくなる。 -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>WorkingDirectory</key>
    <string>__HOME__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>ja_JP.UTF-8</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/mothership/logs/launchd-out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/mothership/logs/launchd-err.log</string>
</dict>
</plist>
