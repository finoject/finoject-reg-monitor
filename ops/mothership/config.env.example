# 母艦常駐の設定。~/mothership/config.env にコピーして使う。
# mothership.sh から `.` で読み込まれる（launchdは環境変数を引き継がないため）。
# Webhook URL 等の秘密情報を含むので、config.env 自体はコミットしない。

# Remote Control セッションの表示名（claude.ai/code のセッション一覧に出る名前）
MOTHERSHIP_SESSION_NAME="母艦"

# pty の割り当て方式: auto | tmux | script
#   tmux   … 後から `tmux -S ~/mothership/tmux.sock attach -t mothership` で画面を覗ける（推奨）
#   script … macOS標準の /usr/bin/script を使う。brew不要だが画面は覗けない
#   auto   … tmux があれば tmux、無ければ script
MOTHERSHIP_PTY="auto"

# claude を起動する作業ディレクトリ
MOTHERSHIP_WORKDIR="$HOME"

# 再起動直後、ネットワークが上がるまで待つ上限（秒）
MOTHERSHIP_NET_WAIT_SEC=180

# 母艦が上がらない/落ちた時の通知先（Incoming Webhook）。
# 母艦が死ぬと Remote Control 経由では何も届かないので、別経路で痕跡を残す。
# healthcheck 側と同じ Webhook で構わない。
# MOTHERSHIP_SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"

# launchd 配下では Keychain が読めず認証に失敗することがある。その場合は母艦のターミナルで
# `claude setup-token` を実行し、得られた長期トークンをここに書く（mothership.sh が export する）。
# CLAUDE_CODE_OAUTH_TOKEN="sk-ant-oat01-..."

# claude が PATH に無い場合の絶対パス
# CLAUDE_BIN="/Users/USERNAME/.local/bin/claude"

# 日次ログの保持日数
MOTHERSHIP_LOG_RETENTION_DAYS=30
