# 母艦ヘルスチェックの設定。~/healthcheck/config.env にコピーして使う。
# このファイルは healthcheck.sh から `.` で読み込まれる（launchdは環境変数を引き継がないため）。
# Webhook URL等の秘密情報を含むので、config.env 自体はリポジトリにコミットしない。

# claudeが死んでいる時のフォールバック通知先（Incoming Webhook）。
# claudeを経由しないので、利用枠上限・認証切れ・タイムアウトでも届く。未設定ならmacOS通知のみ。
# HEALTHCHECK_SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"

# 異常時に点検エージェントがSlack MCPで投稿するチャンネル
SLACK_CHANNEL="#ops"

# reg-monitorの公開出力（generatedAt を見て巡回の生存を判定する）
REG_MONITOR_DATA_URL="https://finoject.github.io/finoject-reg-monitor/data.json"

# generatedAt がこの時間以上前なら異常。巡回は毎時:37なので数回のドロップを許して3時間。
STALE_HOURS=3

# claude -p の打ち切り秒数と最大ターン数
TIMEOUT_SEC=600
MAX_TURNS=30

# 日次ログの保持日数
LOG_RETENTION_DAYS=30
